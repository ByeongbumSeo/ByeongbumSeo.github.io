---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CategoryNav from "../../components/CategoryNav.astro";
import PostList from "../../components/PostList.astro";
import { getKindPosts, getPublishedPosts } from "../../lib/posts";

const posts = getKindPosts(await getPublishedPosts(), "diary");
---

<BaseLayout title="Diary" description="일하며 문제를 해결하고 배우고 생각한 과정을 기록합니다.">
  <section class="page-heading">
    <p class="eyebrow">Diary</p>
    <h1>Diary</h1>
    <p>일하며 문제를 해결하고 배우고 생각한 과정을 남기는 공간입니다.</p>
  </section>
  <CategoryNav kind="diary" posts={posts} />
  <PostList posts={posts} />
</BaseLayout>
